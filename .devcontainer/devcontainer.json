{
  "name": "RUSA AI Free-Tier Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e '.[dev]'",
  "forwardPorts": [8000, 54329],
  "portsAttributes": {
    "8000": {
      "label": "RUSA AI API",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "54329": {
      "label": "RUSA AI development PostgreSQL",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
