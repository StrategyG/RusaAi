FROM python:3.12.16-slim-trixie AS builder

WORKDIR /build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY rusa_agents ./rusa_agents
RUN python -m pip install --upgrade pip "setuptools>=84.1.0" "wheel>=0.46.2" \
    && python -m pip install . \
    && python -m pip uninstall -y setuptools wheel jaraco.context \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && find /usr/local/lib/python3.12 -type d \( -name 'setuptools-*.dist-info' -o -name 'wheel-*.dist-info' -o -name 'pip-*.dist-info' \) -prune -exec rm -rf '{}' + \
    && python - <<'PY'
from importlib.metadata import PackageNotFoundError, version

for package in ("pip", "setuptools", "wheel", "jaraco.context"):
    try:
        installed = version(package)
    except PackageNotFoundError:
        continue
    raise SystemExit(f"build-only package {package}=={installed} remains in executor runtime")
PY

FROM debian:trixie-slim AS runner
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    LD_LIBRARY_PATH=/usr/local/lib HOME=/tmp
ARG DOCKER_CE_CLI_VERSION=5:29.9.3-1~debian.13~trixie

# Only the isolated executor gets a Docker CLI and a mounted rootless socket.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libffi8 \
    && apt-get upgrade -y --no-install-recommends \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "docker-ce-cli=${DOCKER_CE_CLI_VERSION}" \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

COPY --from=builder /usr/local /usr/local
COPY --chown=appuser:appuser rusa_agents /app/rusa_agents

RUN ldd /usr/local/bin/python3.12 | tee /tmp/python-ldd \
    && ! grep -q "not found" /tmp/python-ldd \
    && docker --version \
    && python - <<'PY'
import importlib

for module in ("rusa_agents.sandbox_executor", "rusa_agents.tool_gateway", "fastapi", "psycopg", "httpx"):
    importlib.import_module(module)
print("sandbox executor runtime imports passed")
PY

USER appuser
EXPOSE 9101
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import os,ssl,urllib.request; c=ssl.create_default_context(cafile=os.environ['RUSA_SANDBOX_EXECUTOR_CA_FILE']); urllib.request.urlopen('https://sandbox-executor:9101/healthz', context=c, timeout=3)" || exit 1

ENTRYPOINT []
CMD ["python", "-m", "rusa_agents.sandbox_executor"]
