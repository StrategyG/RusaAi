{
  "id": null,
  "uid": "rusa-ai-overview",
  "title": "RUSA-AI Operations Overview",
  "tags": ["rusa-ai", "production", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Inference p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, model) (rate(rusa_inference_duration_seconds_bucket[5m])))", "legendFormat": "{{model}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "title": "Inference error rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (model) (rate(rusa_inference_requests_total{outcome=\"error\"}[5m])) / clamp_min(sum by (model) (rate(rusa_inference_requests_total[5m])), 0.001)", "legendFormat": "{{model}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "Token throughput (tokens/second)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (model, token_type) (rate(rusa_token_usage_total[5m]))", "legendFormat": "{{model}} / {{token_type}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "Agent task outcomes per second",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (outcome) (rate(rusa_agent_task_executions_total[5m]))", "legendFormat": "{{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "Agent queue depth by state",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max by (state) (rusa_agent_queue_depth)", "legendFormat": "{{state}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "Oldest queued task age (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "max(rusa_agent_queue_oldest_age_seconds)", "legendFormat": "oldest queued task"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 7,
      "title": "RAG retrieval p95 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(rusa_rag_retrieval_duration_seconds_bucket[5m])))", "legendFormat": "retrieval p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 8,
      "title": "RAG quality (Recall@5 / MRR@5 / NDCG@5)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rusa_rag_eval_recall_at_k{k=\"5\",job=\"rusa-rag-evaluation\"}", "legendFormat": "Recall@5"},
        {"expr": "rusa_rag_eval_mrr_at_k{k=\"5\",job=\"rusa-rag-evaluation\"}", "legendFormat": "MRR@5"},
        {"expr": "rusa_rag_eval_ndcg_at_k{k=\"5\",job=\"rusa-rag-evaluation\"}", "legendFormat": "NDCG@5"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "title": "PostgreSQL database size (bytes)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "pg_database_size_bytes{datname=\"rusa_agent\"}", "legendFormat": "rusa_agent"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "options": {"legend": {"displayMode": "hidden"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 10,
      "title": "GPU utilization (percent)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 11,
      "title": "Centralized application and infrastructure logs",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 40},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{service_name=~\".+\"}", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true}
    }
  ]
}