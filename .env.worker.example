# Optional Agent Worker-only remote connectors.
# Copy this file to .env.worker; Docker Compose never passes it to the API or web containers.
# Keep bearer tokens in a secret manager in hosted environments.

# External RAG: disabled by default. Enable only with an administrator-approved HTTPS host.
RUSA_EXTERNAL_RAG_ENABLED=false
RUSA_EXTERNAL_RAG_ENDPOINT=
RUSA_EXTERNAL_RAG_ALLOWED_HOSTS=[]
RUSA_EXTERNAL_RAG_API_KEY=
RUSA_EXTERNAL_RAG_TIMEOUT_SECONDS=15
RUSA_EXTERNAL_RAG_MAX_RESPONSE_BYTES=1000000

# MCP: one isolated connection per tenant. Each entry names a separate environment
# variable for its bearer credential; do not put raw tokens in this JSON.
RUSA_MCP_CONNECTIONS_JSON={}
# Example only (replace endpoint, tenant and tool names after review):
# RUSA_MCP_CONNECTIONS_JSON={"local":{"server_url":"https://mcp.example.org/mcp","allowed_hosts":["mcp.example.org"],"credential_env":"RUSA_MCP_LOCAL_TOKEN","read_only_tools":["search_knowledge"],"timeout_seconds":15,"max_response_bytes":1000000}}
# RUSA_MCP_LOCAL_TOKEN=
