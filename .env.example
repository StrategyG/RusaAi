# Never commit a real secret. Generate a random key with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
RUSA_API_KEY=replace-with-a-random-secret-at-least-32-characters
RUSA_MODEL_NAME=rusa-ai-v1
RUSA_MODEL_PATH=/models/rusa-ai
RUSA_MAX_REQUEST_BYTES=1048576
TASK_ENVELOPE_SCHEMA_PATH=/app/schemas/a2a/task-envelope.schema.json

# Used by docker-compose.yml
RUSA_MODEL_DIR=./models/rusa-ai
RUSA_PORT=8000
RUSA_WEB_PORT=3000

# Human workspace authentication. Replace every value with a unique secret.
RUSA_AUTH_ENABLED=true
RUSA_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
RUSA_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
RUSA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
RUSA_BOOTSTRAP_ADMIN_TENANT_ID=default
RUSA_COOKIE_SECURE=true

# PostgreSQL durable AICode queue. Generate a unique random password.
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password

# Required only when starting the AICode worker profile.
RUSA_PROVIDER_BASE_URL=https://your-approved-openai-compatible-provider.example/v1
RUSA_PROVIDER_ALLOWED_HOSTS=your-approved-openai-compatible-provider.example
RUSA_PROVIDER_MODEL=your-approved-model-id
RUSA_PROVIDER_API_KEY=inject-from-secret-manager
RUSA_GITHUB_TOKEN=inject-least-privilege-github-app-token
RUSA_AGENT_MAX_TURNS=8

RUSA_AGENT_ENABLED=false
# Single-tenant deployment: one allowlist shared by all requests.
RUSA_GITHUB_ALLOWED_REPOSITORIES=StrategyG/RusaAi

# Multi-tenant deployment: map each authenticated tenant to its own repository set.
# Hash API keys with SHA-256; do not put plaintext API keys in this JSON.
# RUSA_API_KEY_TENANTS_JSON={"<sha256-api-key>":"tenant-acme"}
# RUSA_GITHUB_TENANT_REPOSITORIES_JSON={"tenant-acme":["StrategyG/RusaAi"]}
RUSA_WORKER_LEASE_SECONDS=1800
RUSA_TENANT_ID=default

# Optional multi-tenant maps. Leave empty for a single-tenant deployment.
RUSA_API_KEY_TENANTS_JSON=
RUSA_GITHUB_TENANT_REPOSITORIES_JSON=
