# Never commit real secrets. Generate URL-safe secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
RUSA_API_KEY=replace-with-a-random-secret-at-least-32-characters
RUSA_MODEL_NAME=rusa-ai-v1
RUSA_MODEL_PATH=/models/rusa-ai
RUSA_MAX_REQUEST_BYTES=1048576
TASK_ENVELOPE_SCHEMA_PATH=/app/schemas/a2a/task-envelope.schema.json

# Existing inference API
RUSA_MODEL_DIR=./models/rusa-ai
RUSA_PORT=8000

# Agent PostgreSQL owner and restricted runtime roles (all unique, URL-safe secrets)
RUSA_AGENT_DB_PASSWORD=replace-owner-db-password
RUSA_AGENT_WORKER_DB_PASSWORD=replace-worker-db-password
RUSA_AGENT_API_DB_PASSWORD=replace-api-db-password

# JSON map: each tenant receives its own unique API key (minimum 32 characters)
RUSA_AGENT_TENANT_KEYS={"tenant-a":"replace-with-a-random-secret-at-least-32-characters"}
RUSA_AGENT_PORT=8001
RUSA_AGENT_MAX_REQUEST_BYTES=262144

# Exact repository allowlist; comma-separated owner/name values
RUSA_AGENT_ALLOWED_REPOSITORIES=StrategyG/RusaAi

# Agent model provider and repository integration
RUSA_AGENT_PROVIDER_BASE_URL=https://api.example.com/v1
RUSA_AGENT_PROVIDER_API_KEY=replace-with-provider-secret
RUSA_AGENT_MODEL=your-structured-output-capable-model
RUSA_AGENT_PROVIDER_MAX_RESPONSE_BYTES=2000000
RUSA_AGENT_GITHUB_TOKEN=replace-with-repository-scoped-github-app-token
RUSA_AGENT_GITHUB_MAX_RESPONSE_BYTES=4000000
RUSA_AGENT_GITHUB_MAX_FILE_BYTES=1000000
RUSA_AGENT_AUDIT_KEY=replace-with-a-separate-random-secret-at-least-32-characters
RUSA_AGENT_AUDIT_PATH=/var/lib/rusa-agent/audit.jsonl
RUSA_AGENT_PROVIDER_TIMEOUT=45
RUSA_AGENT_WORKER_TIMEOUT=120
RUSA_AGENT_MAX_REPAIR_CYCLES=2
RUSA_AGENT_POLL_INTERVAL=1
RUSA_AGENT_LEASE_SECONDS=300
