# Development defaults only. Replace every placeholder before deployment.
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-random-local-password
# Development compatibility only. Production must not set RUSA_API_KEYS.
RUSA_API_KEYS={"local-dev-key":"development"}
# Production registry: SHA-256(raw API key) -> {subject, tenant_id, roles}.
# Keep raw API keys in a secret manager, never in this environment file.
RUSA_API_KEYS_JSON={}
RUSA_METRICS_API_KEY=replace-with-32-byte-random-ops-key
RUSA_TENANT_REPOSITORIES={"development":["StrategyG/RusaAi"]}
RUSA_DATABASE_URL=postgresql://rusa:replace-with-random-local-password@localhost:5432/rusa

# Production only: separate logins created by migrations/004_aicode_tenant_rls.sql and 005_aicode_task_policy_audit.sql.
# These must be explicit, use the exact role names below, and verify the server
# certificate/hostname. The CA path is inside the production containers.
RUSA_API_DATABASE_URL=postgresql://rusa_api_login:replace-me@db.example.com/rusa?sslmode=verify-full&sslrootcert=/run/secrets/rusa-internal-ca.crt
RUSA_WORKER_DATABASE_URL=postgresql://rusa_worker_login:replace-me@db.example.com/rusa?sslmode=verify-full&sslrootcert=/run/secrets/rusa-internal-ca.crt

RUSA_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
RUSA_WORKSPACE_ROOT=/var/lib/rusa/workspaces
RUSA_GIT_MIRROR_ROOT=/var/lib/rusa/mirrors
RUSA_GITHUB_TOKEN=replace-with-fine-grained-github-token
# OpenAI-compatible RusaModels gateway URL, including /openai/v1.
RUSA_MODEL_BASE_URL=https://model_host.example.com/openai/v1
# Safe placeholder alias; set the exact approved model ID after artifact verification.
RUSA_MODEL_NAME=rusaai-cpu-smoke-test
RUSA_MODEL_API_KEY=
# Optional separate credential for non-production direct worker-to-model use.
# Leave empty when RUSA_WORKER_INFERENCE_GATEWAY=true.
RUSA_WORKER_MODEL_API_KEY=

# Worker-to-API inference gateway. In production, use credential-free HTTPS and
# tenant-specific random secrets in the secret manager; store only SHA-256
# digests plus matching tenant/role claims in RUSA_API_KEYS_JSON.
RUSA_WORKER_INFERENCE_GATEWAY=false
RUSA_WORKER_INFERENCE_BASE_URL=https://api-gateway.example.com/v1
# Host path to the internal CA bundle mounted read-only into the worker.
RUSA_INTERNAL_CA_BUNDLE=/secure/path/to/internal-api-gateway-ca.pem
RUSA_WORKER_INFERENCE_API_KEYS={}
RUSA_WORKER_INFERENCE_DEADLINE_MS=270000

# Shared PostgreSQL inference admission. Every API replica must use the same values.
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=3
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_INFERENCE_LEASE_SECONDS=30

# RusaModels multilingual-e5-small profile. Apply migration 009 and backfill
# each tenant's existing corpus before enabling RAG with 384 dimensions.
RUSA_EMBEDDING_BASE_URL=https://model_host.example.com/openai/v1
RUSA_EMBEDDING_MODEL=rusa-embedding-small
RUSA_EMBEDDING_API_KEY=
RUSA_EMBEDDING_DIMENSIONS=384
RUSA_EMBEDDING_INPUT_TYPE_ENABLED=true
RUSA_EMBEDDING_TIMEOUT=120
RUSA_KNOWLEDGE_DB_ROLE=rusa_knowledge_worker
RUSA_KNOWLEDGE_DATABASE_URL=
RUSA_RAG_ENABLED=false
RUSA_SANDBOX_IMAGE=rusa-ai-agent-sandbox:py312
RUSA_TASK_TIMEOUT_SECONDS=3600
RUSA_DEFAULT_TENANT=development
RUSA_AICODE_ENABLED=false

# Rootless Docker daemon socket on a dedicated agent worker host.
RUSA_DOCKER_SOCKET=/run/user/1001/docker.sock
RUSA_DOCKER_GID=1001

# Encrypts the web control-center session cookie; keep this server-side only.
RUSA_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
