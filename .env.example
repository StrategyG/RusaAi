# Never commit real secrets. Generate URL-safe secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
RUSA_API_KEY=replace-with-a-random-secret-at-least-32-characters
RUSA_MODEL_NAME=rusa-ai-v1
RUSA_MODEL_PATH=/models/rusa-ai
RUSA_MAX_REQUEST_BYTES=1048576
TASK_ENVELOPE_SCHEMA_PATH=/app/schemas/a2a/task-envelope.schema.json

# Existing inference API
RUSA_MODEL_DIR=./models/rusa-ai
RUSA_PORT=8000
RUSA_BIND_ADDRESS=127.0.0.1

# Agent PostgreSQL owner and restricted runtime roles (all unique, URL-safe secrets)
RUSA_AGENT_DB_PASSWORD=replace-owner-db-password
RUSA_AGENT_WORKER_DB_PASSWORD=replace-worker-db-password
RUSA_AGENT_API_DB_PASSWORD=replace-api-db-password

# JSON map: each tenant receives a unique API key (minimum 32 ASCII characters)
RUSA_AGENT_TENANT_KEYS={"tenant-a":"replace-with-a-random-secret-at-least-32-characters"}
RUSA_AGENT_PORT=8001
RUSA_AGENT_MAX_REQUEST_BYTES=262144

# Global repository allowlist and per-tenant repository assignments
RUSA_AGENT_ALLOWED_REPOSITORIES=StrategyG/RusaAi
RUSA_AGENT_TENANT_REPOSITORIES={"tenant-a":["StrategyG/RusaAi"]}

# Agent model provider and repository integration.
# The agent API and worker are opt-in: use docker compose --profile agent.
# Keep provider/GitHub credentials empty until the profile is enabled.
RUSA_AGENT_PROVIDER_BASE_URL=https://api.example.com/v1
RUSA_AGENT_PROVIDER_API_KEY=replace-with-provider-secret
RUSA_AGENT_MODEL=your-structured-output-capable-model
RUSA_AGENT_PROVIDER_MAX_RESPONSE_BYTES=2000000
RUSA_AGENT_GITHUB_TOKEN=replace-with-repository-scoped-github-app-token
RUSA_AGENT_GITHUB_MAX_RESPONSE_BYTES=4000000
RUSA_AGENT_GITHUB_MAX_FILE_BYTES=1000000
RUSA_AGENT_GITHUB_MAX_DIFF_FILES=20
RUSA_AGENT_AUDIT_KEY=replace-with-a-separate-random-secret-at-least-32-characters
RUSA_AGENT_AUDIT_PATH=/var/lib/rusa-agent/audit.jsonl
RUSA_AGENT_PROVIDER_TIMEOUT=45
RUSA_AGENT_WORKER_TIMEOUT=120
RUSA_AGENT_MAX_REPAIR_CYCLES=2
RUSA_AGENT_REQUIRED_CI_CHECKS=["Lint, test, and audit dependencies","Build and smoke-test containers"]
RUSA_AGENT_POLL_INTERVAL=1
RUSA_AGENT_LEASE_SECONDS=300

# Optional tenant-scoped semantic RAG and MCP knowledge plane
RUSA_RAG_ENABLED=false
RUSA_EMBEDDING_BASE_URL=https://api.openai.com/v1
RUSA_EMBEDDING_API_KEY=replace-with-embedding-provider-key
RUSA_EMBEDDING_MODEL=text-embedding-3-small
RUSA_KNOWLEDGE_COLLECTION=agent
RUSA_MCP_PORT=8002
# Configure only when using the remote MCP server; generate unique random tokens per tenant.
RUSA_MCP_SERVER_URL=
RUSA_MCP_TENANT_TOKENS={}
# Map SHA-256(token) to tenant ID for the MCP server; never store plaintext tenant tokens here.
RUSA_MCP_TENANT_KEYS={}
RUSA_MCP_INTERNAL_HTTP_HOSTS=rusa-mcp
RUSA_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,rusa-mcp,rusa-mcp:*
RUSA_MCP_ALLOWED_TOOLS=search_knowledge,get_document,list_collections

# User and admin workspace authentication
RUSA_WEB_PORT=3000
RUSA_WEB_DB_PASSWORD=replace-with-a-unique-url-safe-web-db-password
RUSA_AUTH_ENABLED=true
RUSA_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
RUSA_AUTH_SCHEMA_MANAGED_EXTERNALLY=true
RUSA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
RUSA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
RUSA_BOOTSTRAP_ADMIN_TENANT_ID=tenant-a
RUSA_TENANT_ID=tenant-a
RUSA_COOKIE_SECURE=true
# Enable task submission and dashboard task metrics only when the worker is configured.
RUSA_AGENT_ENABLED=false
