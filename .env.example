# Copy to a secret-managed environment file; never commit real credentials.
ENVIRONMENT=production
LOG_LEVEL=INFO

# Required: use at least 32 random bytes. Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
RUSA_API_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Mount a real Hugging Face-compatible causal-LM checkpoint at this path.
# The service loads local files only and does not download model weights.
RUSA_MODEL_PATH=/models/rusa-ai
RUSA_MODEL_NAME=rusa-ai

# Inference limits. Start conservatively and tune with measured GPU/CPU memory.
RUSA_MAX_INPUT_TOKENS=8192
RUSA_MAX_TOKENS=2048
RUSA_MAX_BATCH_SIZE=4
RUSA_MAX_CONCURRENT_REQUESTS=1
RUSA_QUEUE_TIMEOUT_SECONDS=30

# API protection. Also enforce distributed rate limits at the ingress/load balancer.
RUSA_MAX_REQUEST_BYTES=1048576
RUSA_RATE_LIMIT_PER_MINUTE=120
