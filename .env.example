# Copy to .env and replace every placeholder before deployment.
# Generate passwords with: openssl rand -hex 32
ENVIRONMENT=production
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX_64
RUSA_APP_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_64
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX_64

# JSON object keyed by SHA-256(API_KEY). Replace {} with at least one tenant-bound principal.
# Keep the raw API key outside this file; distribute it through your secret manager.
RUSA_API_KEYS_JSON='{}'

RUSA_DB_POOL_MAX=10
RUSA_RATE_LIMIT_MAX_REQUESTS=60
RUSA_RATE_LIMIT_WINDOW_SECONDS=60
RUSA_MAX_REQUEST_BYTES=1048576
