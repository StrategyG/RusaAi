# Never commit a real secret. Generate secrets with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
RUSA_API_KEY=replace-with-a-random-secret-at-least-32-characters
RUSA_MODEL_NAME=rusa-ai-v1
RUSA_MODEL_PATH=/models/rusa-ai
RUSA_MAX_REQUEST_BYTES=1048576
TASK_ENVELOPE_SCHEMA_PATH=/app/schemas/a2a/task-envelope.schema.json

# Local model mount and ports
RUSA_MODEL_DIR=./models/rusa-ai
RUSA_PORT=8000
RUSA_AGENT_PORT=8010
RUSA_AGENT_WORKER_CONCURRENCY=4

# PostgreSQL password: use a URL-safe random secret.
RUSA_DB_PASSWORD=replace-with-a-url-safe-random-secret

# JSON maps: tenant ID -> independent random secret (minimum 32 characters).
RUSA_TENANT_API_KEYS={"default":"replace-with-a-random-tenant-api-secret-32chars-min"}
RUSA_TENANT_APPROVER_KEYS={"default":"replace-with-a-separate-approver-secret-32chars-min"}

# GitHub token must have least privilege for the target repository:
# contents read/write, pull requests read/write, and Actions checks read.
GITHUB_TOKEN=github_pat_replace_me

# Optional MCP Streamable HTTP servers. Use only trusted HTTPS endpoints.
# Example: {"docs":{"url":"https://mcp.example.com/mcp","token_env":"MCP_SERVER_TOKEN","allow_tools":["search_docs","fetch_doc"]}}
RUSA_MCP_SERVERS=
MCP_SERVER_TOKEN=

# Optional OpenAI-compatible embeddings endpoint. Must return 384-dimensional vectors.
RUSA_EMBEDDING_BASE_URL=
RUSA_EMBEDDING_MODEL=
RUSA_EMBEDDING_API_KEY=
