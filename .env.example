# Never commit a real secret. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=production
RUSA_API_KEY=replace-with-a-random-secret-at-least-32-characters
RUSA_MODEL_NAME=rusa-ai-v1
RUSA_MODEL_PATH=/models
RUSA_MODEL_MANIFEST_SHA256=replace-with-manifest-sha256
RUSA_INFERENCE_BACKEND=transformers
RUSA_MAX_MODEL_LEN=8192
RUSA_MAX_REQUEST_BYTES=1048576
RUSA_BODY_READ_TIMEOUT_SECONDS=15
RUSA_MODEL_LOAD_TIMEOUT_SECONDS=1800
RUSA_MODEL_LOAD_RETRIES=2
RUSA_GENERATION_TIMEOUT_SECONDS=180
RUSA_INFERENCE_RETRIES=1
RUSA_MAX_CONCURRENT_REQUESTS=8
RUSA_MAX_QUEUED_REQUESTS=32
RUSA_QUEUE_TIMEOUT_SECONDS=10
RUSA_MAX_NUM_SEQS=16
RUSA_MAX_NUM_BATCHED_TOKENS=8192
RUSA_TENSOR_PARALLEL_SIZE=1
RUSA_GPU_MEMORY_UTILIZATION=0.9
TASK_ENVELOPE_SCHEMA_PATH=/app/schemas/a2a/task-envelope.schema.json

# Host-side model directory and published port for Docker Compose
RUSA_MODEL_DIR=./models/rusa-ai
RUSA_PORT=8000
