# Development defaults only. Replace every placeholder before deployment.
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-random-local-password
RUSA_API_KEYS={"local-dev-key":"development"}
RUSA_TENANT_REPOSITORIES={"development":["StrategyG/RusaAi"]}
RUSA_DATABASE_URL=postgresql://rusa:replace-with-random-local-password@localhost:5432/rusa
RUSA_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
RUSA_WORKSPACE_ROOT=/var/lib/rusa/workspaces
RUSA_GIT_MIRROR_ROOT=/var/lib/rusa/mirrors
RUSA_GITHUB_TOKEN=replace-with-fine-grained-github-token
RUSA_MODEL_BASE_URL=http://host.docker.internal:8001/v1
RUSA_MODEL_NAME=rusa-ai
RUSA_MODEL_API_KEY=
RUSA_SANDBOX_IMAGE=rusa-ai-agent-sandbox:py312
RUSA_TASK_TIMEOUT_SECONDS=3600
RUSA_DEFAULT_TENANT=development

# Rootless Docker daemon socket on a dedicated agent worker host.
RUSA_DOCKER_SOCKET=/run/user/1001/docker.sock
RUSA_DOCKER_GID=1001
