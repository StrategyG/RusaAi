# Development defaults only. Replace every placeholder before deployment.
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-random-local-password
# Development compatibility only. Production must not set RUSA_API_KEYS.
RUSA_API_KEYS={"local-dev-key":"development"}
# Production registry: SHA-256(raw API key) -> {subject, tenant_id, roles}.
# Keep raw API keys in a secret manager, never in this environment file.
RUSA_API_KEYS_JSON={}
RUSA_METRICS_API_KEY=replace-with-32-byte-random-ops-key
RUSA_TENANT_REPOSITORIES={"development":["StrategyG/RusaAi"]}
RUSA_DATABASE_URL=postgresql://rusa:replace-with-random-local-password@localhost:5432/rusa

# Production only: separate logins created by migrations/004_aicode_tenant_rls.sql and 005_aicode_task_policy_audit.sql.
# These must be explicit, TLS-enabled, and use the exact role names below.
RUSA_API_DATABASE_URL=
RUSA_WORKER_DATABASE_URL=

RUSA_AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
RUSA_WORKSPACE_ROOT=/var/lib/rusa/workspaces
RUSA_GIT_MIRROR_ROOT=/var/lib/rusa/mirrors
RUSA_GITHUB_TOKEN=replace-with-fine-grained-github-token
# OpenAI-compatible RusaModels gateway URL, including /openai/v1.
RUSA_MODEL_BASE_URL=https://rusa-models.example.invalid/openai/v1
RUSA_MODEL_NAME=rusa-general-4b
RUSA_MODEL_API_KEY=

# RusaModels multilingual-e5-small embeddings. Keep 1536 as the legacy default
# until migrations/009 is applied and the tenant's corpus has been re-embedded.
RUSA_EMBEDDING_BASE_URL=https://rusa-models.example.invalid/openai/v1
RUSA_EMBEDDING_MODEL=rusa-embedding-small
RUSA_EMBEDDING_API_KEY=
RUSA_EMBEDDING_DIMENSIONS=384
RUSA_EMBEDDING_INPUT_TYPE_ENABLED=true
RUSA_EMBEDDING_TIMEOUT=120
RUSA_KNOWLEDGE_DB_ROLE=rusa_knowledge_worker
RUSA_KNOWLEDGE_DATABASE_URL=
RUSA_RAG_ENABLED=false
RUSA_SANDBOX_IMAGE=rusa-ai-agent-sandbox:py312
RUSA_TASK_TIMEOUT_SECONDS=3600
RUSA_DEFAULT_TENANT=development
RUSA_AICODE_ENABLED=false

# Rootless Docker daemon socket on a dedicated agent worker host.
RUSA_DOCKER_SOCKET=/run/user/1001/docker.sock
RUSA_DOCKER_GID=1001

# Encrypts the web control-center session cookie; keep this server-side only.
RUSA_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
