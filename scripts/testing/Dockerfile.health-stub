FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc

ARG READY_STATUS=200
ARG RELEASE_ID=ci
ENV READY_STATUS=${READY_STATUS} \
    RELEASE_ID=${RELEASE_ID}

WORKDIR /app
COPY --chown=10001:10001 scripts/testing/health_stub.py /app/health_stub.py

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=2s --timeout=2s --retries=30 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=1)"]
ENTRYPOINT ["python", "/app/health_stub.py"]
