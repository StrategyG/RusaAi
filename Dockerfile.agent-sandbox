FROM python:3.12.16-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTEST_ADDOPTS="-p no:cacheprovider" HOME=/tmp XDG_CACHE_HOME=/tmp/.cache RUFF_CACHE_DIR=/tmp/.cache/ruff
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-agent-sandbox.txt /tmp/requirements-agent-sandbox.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements-agent-sandbox.txt \
    && python -m pip install "ruff>=0.6,<1" "bandit>=1.7,<2" \
    && useradd --create-home --uid 10001 sandbox

# The official Python base image may carry an older setuptools in a lower layer.
# Upgrade it in the final filesystem instead of relying on uninstall whiteouts.
RUN python -m pip install --no-cache-dir --upgrade \
      pip "setuptools>=78.1.1" "wheel>=0.46.2" "jaraco.context>=6.1.0" \
    && python -m pip check \
    && python - <<'PY'
from importlib.metadata import version
from packaging.version import Version

minimums = {"setuptools": "78.1.1", "wheel": "0.46.2", "jaraco.context": "6.1.0"}
for package, minimum in minimums.items():
    installed = version(package)
    if Version(installed) < Version(minimum):
        raise SystemExit(f"{package} {installed} is below required {minimum}")
    print(f"{package}=={installed}")
PY

USER sandbox
ENTRYPOINT []
CMD ["python", "-m", "pytest", "-q"]
