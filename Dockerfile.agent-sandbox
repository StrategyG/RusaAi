FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PYTEST_ADDOPTS="-p no:cacheprovider" HOME=/tmp XDG_CACHE_HOME=/tmp/.cache RUFF_CACHE_DIR=/tmp/.cache/ruff
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-agent-sandbox.txt /tmp/requirements-agent-sandbox.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements-agent-sandbox.txt \
    && python -m pip install "ruff>=0.6,<1" "bandit>=1.7,<2" \
    && useradd --create-home --uid 10001 sandbox

# Build tooling is not required after the test tools have been installed.
RUN python -m pip uninstall -y setuptools wheel jaraco.context || true
# Remove duplicate metadata from both site-packages and dist-packages, including
# stale .dist-info/.egg-info directories that pip may not select for uninstall.
RUN find /usr/local/lib /usr/lib -type d \( \
    -name setuptools -o -name 'setuptools-*.dist-info' -o -name 'setuptools*.egg-info' \
    -o -name wheel -o -name 'wheel-*.dist-info' -o -name 'wheel*.egg-info' \
    -o -path '*/jaraco/context' -o -name 'jaraco_context-*.dist-info' \
  \) -prune -exec rm -rf '{}' + \
  && if find /usr/local/lib /usr/lib -type d \( \
       -name setuptools -o -name 'setuptools-*.dist-info' -o -name 'setuptools*.egg-info' \
       -o -name wheel -o -name 'wheel-*.dist-info' -o -name 'wheel*.egg-info' \
       -o -path '*/jaraco/context' -o -name 'jaraco_context-*.dist-info' \
     \) -print -quit | grep -q .; then \
       echo "Build-only Python packaging tools remain in the runtime image" >&2; exit 1; \
     fi \
  && python -m pip check \
  && python - <<'PY'
from importlib.metadata import PackageNotFoundError, version

for package in ("setuptools", "wheel", "jaraco.context"):
    try:
        installed = version(package)
    except PackageNotFoundError:
        continue
    raise SystemExit(f"Build-only package {package} ({installed}) must not ship in runtime")
PY

USER sandbox
ENTRYPOINT []
CMD ["python", "-m", "pytest", "-q"]
