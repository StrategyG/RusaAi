{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusa-ai:model-plane:inference-response:0.1.0",
  "title": "RUSA Model Plane Inference Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "status",
    "model",
    "output",
    "usage",
    "finish_reason",
    "trace_id"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "const": "completed"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "model_id",
        "model_version",
        "deployment_id",
        "deployment_zone",
        "region"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "deployment_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "tool_call_proposals"
      ],
      "properties": {
        "content": {
          "type": "string"
        },
        "tool_call_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "arguments"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_microunits",
        "currency"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "finish_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
