{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusa-ai:model-plane:inference-request:0.1.0",
  "title": "RUSA Model Plane Inference Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "run_id",
    "task_id",
    "model_profile",
    "capability",
    "input",
    "constraints",
    "deadline"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "model_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "capability": {
      "const": "chat"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messages",
        "max_output_tokens"
      ],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "developer",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_classification",
        "region",
        "max_latency_ms",
        "budget",
        "fallback"
      ],
      "properties": {
        "data_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 1
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_input_tokens",
            "max_output_tokens",
            "currency",
            "max_cost_microunits"
          ],
          "properties": {
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "max_cost_microunits": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "fallback": {
          "enum": [
            "deny",
            "allow_authorized"
          ]
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  }
}
