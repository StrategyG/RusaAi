# RusaAi CPU Control Plane profile. The Model Plane runs separately in RusaModels.
# Start and verify the RusaModels Model Server before enabling RusaAi inference.
# This alias matches the current RusaModels CPU smoke profile; it is NOT RusaAi-Edge.
# RusaAi-Edge-1.54B remains a non-Qwen target with no selected checkpoint/GGUF yet.
RUSA_MODEL_BASE_URL=https://<model-server-host>/openai/v1
RUSA_MODEL_NAME=rusa-general-4b
# Use a dedicated RusaModels principal with role=inference. Never use manager/admin tokens.
RUSA_MODEL_API_KEY=replace-with-dedicated-rusamodels-inference-token

# RusaAi gateway admission: one active generation and a bounded waiting queue.
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=3
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300

# Development-only worker service identity. Production must replace this with
# per-tenant >=32-byte secrets stored in the secret manager and registered by
# SHA-256 digest in RUSA_API_KEYS_JSON with the matching tenant and developer role.
RUSA_WORKER_INFERENCE_API_KEYS={"development":"local-dev-key"}
RUSA_WORKER_INFERENCE_DEADLINE_MS=270000

# Shared PostgreSQL inference slot lease for the RusaAi API gateway.
RUSA_INFERENCE_LEASE_SECONDS=30

# Route worker calls through the RusaAi gateway so API and agent inference share
# one bounded admission controller. This local HTTP route is not production TLS.
RUSA_WORKER_INFERENCE_GATEWAY=true
RUSA_AICODE_ENABLED=true
RUSA_MAX_PARALLEL_WORKERS=1
