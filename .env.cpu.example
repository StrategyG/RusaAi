# Merge these CPU-only settings into the existing .env file.
# Keep the GGUF model outside the Git repository and use its absolute path.
RUSA_GGUF_MODEL_PATH=/srv/rusa/models/model.gguf
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
RUSA_MODEL_NAME=rusa-cpu
RUSA_MODEL_CONTEXT=4096
RUSA_CPU_THREADS=4
RUSA_MODEL_PARALLEL=1
RUSA_MODEL_MEMORY_LIMIT=8g
RUSA_MODEL_CPU_LIMIT=4.0
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=4
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300

# Pin the exact GGUF file. The verifier rejects a missing or mismatched digest.
RUSA_GGUF_MODEL_SHA256=replace-with-64-character-approved-sha256