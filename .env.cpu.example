# Merge these CPU-only settings into the existing .env file. This is the rusa-cpu-16 (16-GB) queue profile.
# The smoke-test alias is intentional: no approved RusaAi-Edge checkpoint/GGUF exists yet.
# Use rusaai-edge-1.54b only for an audited checkpoint matching the exact reference architecture.
# If the approved non-Qwen checkpoint differs, use the derived model ID and its actual context.
# For an 8-GB device, also merge .env.cpu-8gb.example to reduce waiting work.
# Keep the GGUF model outside the Git repository and use its absolute path.
RUSA_GGUF_MODEL_PATH=/srv/rusa/models/model.gguf
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
RUSA_MODEL_NAME=rusaai-cpu-smoke-test
RUSA_MODEL_CONTEXT=4096
RUSA_CPU_THREADS=4
RUSA_MODEL_PARALLEL=1
RUSA_MODEL_MEMORY_LIMIT=8g
RUSA_MODEL_CPU_LIMIT=4.0
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=3
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300

# Pin the exact GGUF file. The verifier rejects a missing or mismatched digest.
RUSA_GGUF_MODEL_SHA256=replace-with-64-character-approved-sha256
# Development-only worker service identity. Production must replace this with
# per-tenant >=32-byte secrets stored in the secret manager and registered by
# SHA-256 digest in RUSA_API_KEYS_JSON with the matching tenant and developer role.
RUSA_WORKER_INFERENCE_API_KEYS={"development":"local-dev-key"}
RUSA_WORKER_INFERENCE_DEADLINE_MS=270000

# Shared PostgreSQL inference slot lease for the API gateway.
RUSA_INFERENCE_LEASE_SECONDS=30

# Route worker calls through the API gateway so API and agent inference share
# one bounded admission controller. This local HTTP route is not production TLS.
RUSA_WORKER_INFERENCE_GATEWAY=true
RUSA_AICODE_ENABLED=true
RUSA_MAX_PARALLEL_WORKERS=1

# Shared secret for the read-only llama.cpp memory telemetry sidecar.
# Use a random secret with at least 32 bytes; keep it out of Git in real deployments.
RUSA_MODEL_TELEMETRY_API_KEY=replace-with-32-byte-random-telemetry-key
