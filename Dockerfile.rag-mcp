FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-rag-mcp.txt ./
RUN python -m pip install --no-cache-dir -r requirements-rag-mcp.txt \
    && groupadd --system --gid 10001 rusa \
    && useradd --system --uid 10001 --gid rusa --home-dir /nonexistent --shell /usr/sbin/nologin rusa

COPY rusa_knowledge /app/rusa_knowledge
COPY rusa_mcp /app/rusa_mcp

USER 10001:10001

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8002/health/live', timeout=3)" || exit 1

CMD ["uvicorn", "rusa_mcp.server:app", "--host", "0.0.0.0", "--port", "8002", "--workers", "1"]
