{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa.ai/schemas/devops/v1/agent-task.schema.json",
  "title": "RUSA AI Agentic DevOps Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "workflow_id",
    "tenant_id",
    "agent_id",
    "stage",
    "objective",
    "input",
    "constraints",
    "attempt",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "rusa_plan_agent",
        "rusa_code_agent",
        "rusa_build_agent",
        "rusa_test_agent",
        "rusa_release_agent",
        "rusa_deploy_agent",
        "rusa_operate_agent",
        "rusa_monitor_agent",
        "rusa_security_guard_agent"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "plan",
        "code",
        "build",
        "test",
        "release",
        "deploy",
        "operate",
        "monitor"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "input": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "user_request": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_branch": {
          "type": "string",
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]{0,180}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "plan_ref": {
          "type": "string",
          "format": "uri"
        },
        "plan_evidence_ref": {
          "type": "string",
          "format": "uri"
        },
        "acceptance_criteria_ref": {
          "type": "string",
          "format": "uri"
        },
        "build_config_ref": {
          "type": "string",
          "format": "uri"
        },
        "test_plan_ref": {
          "type": "string",
          "format": "uri"
        },
        "build_evidence_ref": {
          "type": "string",
          "format": "uri"
        },
        "test_evidence_ref": {
          "type": "string",
          "format": "uri"
        },
        "sbom_ref": {
          "type": "string",
          "format": "uri"
        },
        "release_manifest_ref": {
          "type": "string",
          "format": "uri"
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "eval",
            "staging",
            "production"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "incident_ref": {
          "type": "string",
          "format": "uri"
        },
        "runbook_ref": {
          "type": "string",
          "format": "uri"
        },
        "metrics_window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "maxItems": 100
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_tools",
        "network_access",
        "write_scope",
        "approval_required",
        "budget"
      ],
      "properties": {
        "allowed_tools": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "enum": [
              "alerts.read",
              "artifact.read",
              "artifact.write",
              "audit.read",
              "build.execute",
              "deployment.execute",
              "documentation.write",
              "evidence.read",
              "evidence.write",
              "health.read",
              "incident.write",
              "issue.read",
              "logs.read",
              "manifest.write",
              "metrics.read",
              "plan.write",
              "policy.read",
              "release.prepare",
              "release.read",
              "repository.branch.write",
              "repository.read",
              "runbook.execute",
              "runbook.read",
              "sbom.read",
              "sbom.write",
              "task.create",
              "test.execute",
              "test.write",
              "traces.read"
            ]
          }
        },
        "network_access": {
          "type": "boolean"
        },
        "allowed_network_destinations": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "write_scope": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        },
        "approval_required": {
          "type": "boolean"
        },
        "approval_scope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "merge",
              "release",
              "deploy",
              "secret_change",
              "permission_change",
              "destructive_action",
              "production_data_change",
              "external_publication"
            ]
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "max_tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "max_runtime_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "max_cost_usd",
            "max_tool_calls",
            "max_runtime_seconds"
          ]
        },
        "approval_ref": {
          "type": "string",
          "format": "uri"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "network_access": {
                "const": true
              }
            },
            "required": [
              "network_access"
            ]
          },
          "then": {
            "required": [
              "allowed_network_destinations"
            ],
            "properties": {
              "allowed_network_destinations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "network_access": {
                "const": false
              }
            },
            "required": [
              "network_access"
            ]
          },
          "then": {
            "properties": {
              "allowed_network_destinations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_agent",
        "event"
      ],
      "properties": {
        "next_agent": {
          "type": "string",
          "enum": [
            "rusa_plan_agent",
            "rusa_code_agent",
            "rusa_build_agent",
            "rusa_test_agent",
            "rusa_release_agent",
            "rusa_deploy_agent",
            "rusa_operate_agent",
            "rusa_monitor_agent",
            "rusa_security_guard_agent"
          ]
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "requested_by",
        "policy_version"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "requested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "traceparent": {
          "type": "string",
          "pattern": "^00-(?!0{32}-)[a-f0-9]{32}-(?!0{16}-)[a-f0-9]{16}-[a-f0-9]{2}$"
        },
        "model_id": {
          "type": "string",
          "maxLength": 256
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "plan"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_plan_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "user_request"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "code"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_code_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "repository",
              "plan_ref",
              "acceptance_criteria",
              "plan_evidence_ref",
              "acceptance_criteria_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "build"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_build_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "repository",
              "commit_sha",
              "build_config_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "test"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_test_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "commit_sha",
              "test_plan_ref",
              "acceptance_criteria_ref",
              "artifact_digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_test_agent"
          },
          "stage": {
            "const": "test"
          }
        },
        "required": [
          "agent_id",
          "stage"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "build_evidence_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "release"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_release_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "commit_sha",
              "artifact_digest",
              "test_evidence_ref",
              "sbom_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "deploy"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_deploy_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "release_manifest_ref",
              "environment",
              "commit_sha",
              "artifact_digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "operate"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_operate_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "service",
              "runbook_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "monitor"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "agent_id": {
            "enum": [
              "rusa_monitor_agent",
              "rusa_security_guard_agent"
            ]
          },
          "input": {
            "required": [
              "service",
              "metrics_window"
            ]
          },
          "constraints": {
            "properties": {
              "network_access": {
                "const": false
              },
              "write_scope": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_security_guard_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "evidence_refs"
            ]
          },
          "constraints": {
            "properties": {
              "write_scope": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_plan_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "repository.read",
                    "issue.read",
                    "artifact.read",
                    "task.create",
                    "plan.write"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_code_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "repository.read",
                    "issue.read",
                    "artifact.read",
                    "repository.branch.write",
                    "test.write",
                    "documentation.write"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_build_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "repository.read",
                    "artifact.read",
                    "build.execute",
                    "artifact.write",
                    "sbom.write",
                    "evidence.write"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_test_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "repository.read",
                    "artifact.read",
                    "test.execute",
                    "evidence.write",
                    "metrics.read"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_release_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "artifact.read",
                    "evidence.read",
                    "release.prepare",
                    "manifest.write",
                    "sbom.read"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_deploy_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "artifact.read",
                    "release.read",
                    "deployment.execute",
                    "health.read",
                    "runbook.read"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_operate_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "metrics.read",
                    "logs.read",
                    "runbook.read",
                    "runbook.execute",
                    "incident.write"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_monitor_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "metrics.read",
                    "logs.read",
                    "traces.read",
                    "alerts.read"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "rusa_security_guard_agent"
          }
        },
        "required": [
          "agent_id"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "properties": {
              "allowed_tools": {
                "items": {
                  "enum": [
                    "repository.read",
                    "issue.read",
                    "artifact.read",
                    "evidence.read",
                    "policy.read",
                    "audit.read",
                    "metrics.read",
                    "logs.read",
                    "traces.read"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "deploy"
          },
          "input": {
            "properties": {
              "environment": {
                "const": "production"
              }
            },
            "required": [
              "environment"
            ]
          }
        },
        "required": [
          "stage",
          "input"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "required": [
              "approval_required",
              "approval_scope",
              "approval_ref"
            ],
            "properties": {
              "approval_required": {
                "const": true
              },
              "approval_scope": {
                "contains": {
                  "const": "deploy"
                }
              },
              "approval_ref": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  ]
}
