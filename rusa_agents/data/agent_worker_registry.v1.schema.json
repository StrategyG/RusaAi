{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusaai.local/schemas/agent-runtime-registry-1.0.schema.json",
  "title": "RusaAi Agent Runtime Registry v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "generated_at",
    "project_id",
    "status",
    "source_registry_version",
    "counts",
    "roles",
    "source_chunk_map_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "const": "rusaai-agent-worker-capability-registry"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "project_id": {
      "const": "rusaai"
    },
    "status": {
      "enum": [
        "draft_proposed_not_activated",
        "active"
      ]
    },
    "source_registry_version": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "required": [
        "agents",
        "aicode_workers",
        "devops_lifecycle_profiles",
        "workers_total",
        "provisional_capability_ids_total",
        "source_chunks_total",
        "source_chunk_refs_total"
      ],
      "properties": {
        "agents": {
          "const": 10
        },
        "aicode_workers": {
          "const": 6
        },
        "devops_lifecycle_profiles": {
          "const": 8
        },
        "workers_total": {
          "const": 14
        },
        "source_chunks_total": {
          "const": 0
        },
        "provisional_capability_ids_total": {
          "const": 34
        },
        "source_chunk_refs_total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "role_id",
          "display_name",
          "identity_type",
          "scope",
          "parent_role_id",
          "registration_status",
          "runtime_status",
          "activation_state",
          "mission",
          "capability_ids",
          "source_chunk_ids"
        ],
        "properties": {
          "role_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "identity_type": {
            "enum": [
              "core_agent",
              "aicode_worker",
              "devops_lifecycle_profile"
            ]
          },
          "scope": {
            "type": "object",
            "required": [
              "agent_scope",
              "worker_scope"
            ],
            "properties": {
              "agent_scope": {
                "type": "string",
                "enum": [
                  "agent_core",
                  "agent_platform",
                  "agent_domain",
                  "agent_retrieval"
                ]
              },
              "worker_scope": {
                "type": "string",
                "enum": [
                  "worker_core",
                  "worker_adjacent",
                  "incidental_mention",
                  "not_worker"
                ]
              }
            },
            "additionalProperties": false
          },
          "parent_role_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "registration_status": {
            "type": "string"
          },
          "runtime_status": {
            "type": "string"
          },
          "activation_state": {
            "type": "string"
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "capability_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RUSA-AW-(AGENT|WORKER|DEVOPS|CAP|GOV)-[0-9]{3}$"
            }
          },
          "source_chunk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RUSA-KB-[0-9]{3}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "source_chunk_map_status": {
      "enum": [
        "candidate_crosswalk_pending_review",
        "approved_for_routing"
      ]
    }
  },
  "additionalProperties": false
}
