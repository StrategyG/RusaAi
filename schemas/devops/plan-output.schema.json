{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa.ai/schemas/devops/v1/plan-output.schema.json",
  "title": "RUSA AI Plan Agent Structured Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "summary",
    "goal",
    "scope",
    "requirements",
    "tasks",
    "acceptance_criteria",
    "dependencies",
    "risks",
    "approval_recommended",
    "approval_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "out_of_scope": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "functional",
        "nonfunctional"
      ],
      "properties": {
        "functional": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "nonfunctional": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[A-Z0-9][A-Z0-9_-]{0,31}$"
          },
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "likelihood",
          "impact",
          "mitigation",
          "approval_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "approval_required": {
            "type": "boolean"
          }
        }
      }
    },
    "approval_recommended": {
      "type": "boolean"
    },
    "approval_reasons": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9][A-Z0-9_-]{0,31}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "stage",
        "agent_id",
        "depends_on",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-[A-Z0-9][A-Z0-9_-]{0,31}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "stage": {
          "enum": [
            "code",
            "build",
            "test",
            "release",
            "deploy",
            "operate",
            "monitor"
          ]
        },
        "agent_id": {
          "enum": [
            "rusa_code_agent",
            "rusa_build_agent",
            "rusa_test_agent",
            "rusa_release_agent",
            "rusa_deploy_agent",
            "rusa_operate_agent",
            "rusa_monitor_agent"
          ]
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^TASK-[A-Z0-9][A-Z0-9_-]{0,31}$"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_recommended": {
            "const": true
          }
        },
        "required": [
          "approval_recommended"
        ]
      },
      "then": {
        "properties": {
          "approval_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
