{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa-ai.dev/schemas/devops/agent-identity.schema.json",
  "title": "RUSA AI Agent Identity v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "enum": [
        "orchestrator",
        "specialist",
        "security_guard",
        "support"
      ]
    },
    "stage": {
      "enum": [
        "plan",
        "code",
        "build",
        "test",
        "release",
        "deploy",
        "operate",
        "monitor"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "1.0.0"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "allowed_tools": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "policy_scopes": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "required": [
    "agent_id",
    "display_name",
    "kind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "specialist"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "stage"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "orchestrator",
              "security_guard",
              "support"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "not": {
          "required": [
            "stage"
          ]
        }
      }
    }
  ]
}