{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa-ai.dev/schemas/devops/workflow-event.schema.json",
  "title": "RUSA AI Workflow Event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "enum": [
        "task.request",
        "task.accepted",
        "task.progress",
        "tool.invocation",
        "task.completed",
        "task.failed",
        "policy.violation",
        "task.cancel.requested",
        "task.cancelled",
        "audit.recorded"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "minLength": 1
    },
    "attempt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 100
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "minLength": 1
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32}-)[a-f0-9]{32}-(?!0{16}-)[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "type",
    "message_id",
    "tenant_id",
    "run_id",
    "correlation_id",
    "traceparent",
    "producer",
    "occurred_at",
    "payload"
  ],
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "task.request"
        },
        "payload": {
          "$ref": "#/$defs/taskRequest"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "task.accepted"
        },
        "payload": {
          "$ref": "#/$defs/taskAccepted"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "task.progress"
        },
        "payload": {
          "$ref": "#/$defs/taskProgress"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "tool.invocation"
        },
        "payload": {
          "$ref": "#/$defs/toolInvocation"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "task.completed"
        },
        "payload": {
          "$ref": "#/$defs/taskCompleted"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "task.failed"
        },
        "payload": {
          "$ref": "#/$defs/taskFailed"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "policy.violation"
        },
        "payload": {
          "$ref": "#/$defs/policyViolation"
        }
      }
    },
    {
      "properties": {
        "type": {
          "const": "task.cancel.requested"
        },
        "payload": {
          "$ref": "#/$defs/taskCancelRequested"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "task.cancelled"
        },
        "payload": {
          "$ref": "#/$defs/taskCancelled"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "task_id",
        "attempt"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "audit.recorded"
        },
        "payload": {
          "$ref": "#/$defs/auditRecorded"
        }
      }
    }
  ],
  "$defs": {
    "taskRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        }
      },
      "required": [
        "capability",
        "input_ref",
        "deadline_at",
        "idempotency_key",
        "priority"
      ]
    },
    "taskAccepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "worker_id",
        "lease_epoch",
        "state_version"
      ]
    },
    "taskProgress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "percent",
        "stage"
      ]
    },
    "toolInvocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "tool",
        "action",
        "input_ref",
        "operation_id",
        "lease_epoch"
      ]
    },
    "taskCompleted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "result_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "result_ref",
        "sha256"
      ]
    },
    "taskFailed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "enum": [
            "TRANSIENT",
            "PERMANENT",
            "POLICY",
            "AMBIGUOUS"
          ]
        },
        "side_effect": {
          "enum": [
            "NONE",
            "APPLIED",
            "UNKNOWN"
          ]
        },
        "diagnostic_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "code",
        "category",
        "side_effect"
      ]
    },
    "policyViolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "decision_id",
        "action",
        "resource_ref",
        "reason_code"
      ]
    },
    "taskCancelRequested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancel_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "cancel_epoch",
        "reason_code"
      ]
    },
    "taskCancelled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cancel_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "side_effect": {
          "enum": [
            "NONE",
            "APPLIED",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "cancel_epoch",
        "state_version",
        "side_effect"
      ]
    },
    "auditRecorded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "policy_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "state_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "action",
        "outcome",
        "resource_ref"
      ]
    }
  }
}