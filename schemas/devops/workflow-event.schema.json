{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa.ai/schemas/devops/workflow-event.schema.json",
  "title": "RUSA-AI Workflow Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "message_id",
    "tenant_id",
    "workflow_id",
    "run_id",
    "correlation_id",
    "traceparent",
    "producer",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "enum": [
        "task.request",
        "task.accepted",
        "task.progress",
        "tool.invocation",
        "task.completed",
        "task.failed",
        "policy.violation",
        "task.cancel.requested",
        "task.cancelled",
        "audit.recorded",
        "plan.completed",
        "code.completed",
        "build.completed",
        "test.completed",
        "release.approved",
        "deploy.completed",
        "operate.incident_detected",
        "operate.recovered",
        "monitor.alert_triggered",
        "monitor.feedback_created",
        "workflow.blocked",
        "workflow.completed"
      ]
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflow_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32}-)[a-f0-9]{32}-(?!0{16}-)[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "producer": {
      "type": "string",
      "enum": [
        "supreme_orchestrator",
        "system_architect",
        "planner",
        "task_decomposer",
        "software_engineer",
        "devops",
        "qa_testing",
        "security_policy",
        "memory_knowledge",
        "evaluation_reporting",
        "rusa_devops_orchestrator",
        "rusa_plan_agent",
        "rusa_code_agent",
        "rusa_build_agent",
        "rusa_test_agent",
        "rusa_release_agent",
        "rusa_deploy_agent",
        "rusa_operate_agent",
        "rusa_monitor_agent",
        "rusa_security_guard_agent",
        "api-gateway",
        "workflow-engine",
        "tool-gateway",
        "audit-sink"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "worker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "state_version": {
          "type": "integer",
          "minimum": 1
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "stage": {
          "enum": [
            "plan",
            "code",
            "build",
            "test",
            "release",
            "deploy",
            "operate",
            "monitor",
            "security"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "result_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "enum": [
            "TRANSIENT",
            "PERMANENT",
            "POLICY",
            "AMBIGUOUS"
          ]
        },
        "side_effect": {
          "enum": [
            "NONE",
            "APPLIED",
            "UNKNOWN"
          ]
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cancel_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "passed",
            "failed",
            "blocked",
            "needs_approval",
            "cancelled",
            "skipped"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "release_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "environment": {
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "deployment_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "health_status": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ]
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "incident_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "recovery_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "alert_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_value": {
          "type": [
            "number",
            "string"
          ]
        },
        "feedback_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "blocking_task_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.progress"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.invocation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.failed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.cancel.requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.cancelled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.request"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "capability",
              "input_ref",
              "deadline_at",
              "idempotency_key",
              "priority"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "worker_id",
              "lease_epoch",
              "state_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.progress"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "lease_epoch",
              "state_version",
              "percent",
              "stage"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.invocation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "tool",
              "action",
              "input_ref",
              "operation_id",
              "lease_epoch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "lease_epoch",
              "state_version",
              "result_ref",
              "sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.failed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "lease_epoch",
              "state_version",
              "code",
              "category",
              "side_effect"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.violation"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "policy_id",
              "policy_version",
              "decision_id",
              "action",
              "resource_ref",
              "reason_code"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.cancel.requested"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "cancel_epoch",
              "reason_code"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "task.cancelled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "cancel_epoch",
              "state_version",
              "side_effect"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "audit.recorded"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "action",
              "outcome",
              "resource_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "stage",
              "status",
              "result_ref",
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "code.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "stage",
              "status",
              "result_ref",
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "build.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "stage",
              "status",
              "result_ref",
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "test.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "stage",
              "status",
              "result_ref",
              "evidence_refs"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release.approved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "release_ref",
              "manifest_digest",
              "approval_ref",
              "approver"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "deploy.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "environment",
              "deployment_ref",
              "health_status",
              "artifact_digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "operate.incident_detected"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "incident_ref",
              "severity",
              "summary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "operate.recovered"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "incident_ref",
              "recovery_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "monitor.alert_triggered"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "alert_ref",
              "severity",
              "metric",
              "observed_value"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "monitor.feedback_created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "feedback_ref",
              "source_ref",
              "objective"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workflow.blocked"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason_code",
              "summary"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workflow.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "result_ref",
              "evidence_refs"
            ]
          }
        }
      }
    }
  ]
}
