{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusa-ai.dev/schemas/devops/agent-task.schema.json",
  "title": "RUSA AI Agent Task v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "minLength": 1
    },
    "source_agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$",
      "description": "Assigned target identity; equivalent to target_agent in the earlier Complete Agent Communication Contract."
    },
    "stage": {
      "enum": [
        "plan",
        "code",
        "build",
        "test",
        "release",
        "deploy",
        "operate",
        "monitor"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "input_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/artifactReference"
      }
    },
    "context": {
      "type": "object"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ],
      "default": "P2"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128,
      "minLength": 1
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32}-)[a-f0-9]{32}-(?!0{16}-)[a-f0-9]{16}-[a-f0-9]{2}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "workflow_id",
    "tenant_id",
    "source_agent",
    "agent_id",
    "stage",
    "objective",
    "acceptance_criteria",
    "deadline_at",
    "idempotency_key",
    "correlation_id",
    "traceparent",
    "attempt"
  ],
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "required": [
        "uri",
        "sha256"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "network_access": {
          "type": "boolean",
          "default": false
        },
        "write_scope": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "approval_required": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}