{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusaai:mcp-connection:1.0",
  "title": "RUSA AI Remote MCP Connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "transport", "endpoint", "allowed_hosts", "credential_ref", "allowed_tools", "enabled", "tls_verify", "follow_redirects", "timeout_seconds", "max_response_bytes", "approval_mode"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
    "transport": { "const": "streamable_http" },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://" },
    "allowed_hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "credential_ref": { "type": "string", "pattern": "^secret://[A-Za-z0-9._/-]{1,200}$" },
    "allowed_tools": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "enabled": { "type": "boolean", "default": false },
    "tls_verify": { "const": true },
    "follow_redirects": { "const": false },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 5000000 },
    "approval_mode": { "enum": ["read_only", "approval_required"] }
  }
}
