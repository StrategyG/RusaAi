{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusaai:external-rag-connection:1.0",
  "title": "RUSA AI External RAG Connection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "endpoint", "allowed_hosts", "credential_ref", "enabled", "tls_verify", "follow_redirects", "timeout_seconds", "max_response_bytes", "top_k", "send_local_context"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Must end in /v1/retrieve and match an administrator-approved host." },
    "allowed_hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "credential_ref": { "type": "string", "pattern": "^secret://[A-Za-z0-9._/-]{1,200}$" },
    "enabled": { "type": "boolean", "default": false },
    "tls_verify": { "const": true },
    "follow_redirects": { "const": false },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
    "max_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 5000000 },
    "top_k": { "type": "integer", "minimum": 1, "maximum": 20 },
    "send_local_context": { "const": false },
    "tenant_scope_header": { "type": "boolean", "default": false }
  }
}
