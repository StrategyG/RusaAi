{
  "$id": "https://schemas.rusa.ai/platform/policy-decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versioned deterministic authorization decision; no model-supplied outcome.",
  "properties": {
    "action": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "approval_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "resource_ref": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Resource Ref",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "workflow_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "tenant_id",
    "actor",
    "action",
    "resource_ref",
    "policy_id",
    "policy_version",
    "outcome",
    "reason_code",
    "input_sha256"
  ],
  "title": "PolicyDecisionV1",
  "type": "object"
}
