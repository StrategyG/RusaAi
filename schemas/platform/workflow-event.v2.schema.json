{
  "$defs": {
    "ApprovalDecisionPayloadV2": {
      "properties": {
        "approval_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "expired",
            "cancelled"
          ],
          "title": "Decision",
          "type": "string"
        },
        "policy_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "policy_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Version"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "approval_id",
        "decision",
        "decided_by"
      ],
      "title": "ApprovalDecisionPayloadV2",
      "type": "object"
    },
    "ApprovalRequestPayloadV2": {
      "properties": {
        "action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "approval_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Approval Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requested_by": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requested By",
          "type": "string"
        },
        "resource_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Resource Ref",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "requested_by",
        "action",
        "resource_ref",
        "reason",
        "policy_id",
        "policy_version"
      ],
      "title": "ApprovalRequestPayloadV2",
      "type": "object"
    },
    "AuditRecordedPayloadV2": {
      "properties": {
        "action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "audit_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Audit Ref",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "action",
        "decision",
        "audit_ref"
      ],
      "title": "AuditRecordedPayloadV2",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Immutable evidence reference bound to a content digest.",
      "properties": {
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "producer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "subject_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Digest"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "kind",
        "producer_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "PolicyDecisionPayloadV2": {
      "properties": {
        "action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allow",
            "deny",
            "require_approval"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "resource_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Resource Ref",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "policy_id",
        "policy_version",
        "decision",
        "action",
        "resource_ref"
      ],
      "title": "PolicyDecisionPayloadV2",
      "type": "object"
    },
    "PolicyViolationPayloadV2": {
      "properties": {
        "action": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "decision_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "resource_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Resource Ref",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_version",
        "decision_id",
        "action",
        "resource_ref",
        "reason_code"
      ],
      "title": "PolicyViolationPayloadV2",
      "type": "object"
    },
    "SideEffectStatus": {
      "enum": [
        "NONE",
        "APPLIED",
        "UNKNOWN"
      ],
      "title": "SideEffectStatus",
      "type": "string"
    },
    "TaskAcceptedPayloadV2": {
      "properties": {
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        },
        "worker_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "lease_epoch",
        "state_version"
      ],
      "title": "TaskAcceptedPayloadV2",
      "type": "object"
    },
    "TaskCancellationRequestedPayloadV2": {
      "properties": {
        "cancel_epoch": {
          "minimum": 1,
          "title": "Cancel Epoch",
          "type": "integer"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "cancel_epoch",
        "reason_code"
      ],
      "title": "TaskCancellationRequestedPayloadV2",
      "type": "object"
    },
    "TaskCancelledPayloadV2": {
      "properties": {
        "cancel_epoch": {
          "minimum": 1,
          "title": "Cancel Epoch",
          "type": "integer"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffectStatus"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        }
      },
      "required": [
        "cancel_epoch",
        "state_version",
        "side_effect"
      ],
      "title": "TaskCancelledPayloadV2",
      "type": "object"
    },
    "TaskCompletedPayloadV2": {
      "properties": {
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "result_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Result Ref",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?:sha256:)?[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "result_ref",
        "sha256"
      ],
      "title": "TaskCompletedPayloadV2",
      "type": "object"
    },
    "TaskFailedPayloadV2": {
      "properties": {
        "category": {
          "$ref": "#/$defs/TaskFailureCategory"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "diagnostic_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diagnostic Ref"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffectStatus"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "code",
        "category",
        "side_effect"
      ],
      "title": "TaskFailedPayloadV2",
      "type": "object"
    },
    "TaskFailureCategory": {
      "enum": [
        "TRANSIENT",
        "PERMANENT",
        "POLICY",
        "AMBIGUOUS"
      ],
      "title": "TaskFailureCategory",
      "type": "string"
    },
    "TaskProgressPayloadV2": {
      "properties": {
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Percent",
          "type": "integer"
        },
        "stage": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "state_version": {
          "minimum": 1,
          "title": "State Version",
          "type": "integer"
        }
      },
      "required": [
        "lease_epoch",
        "state_version",
        "percent",
        "stage"
      ],
      "title": "TaskProgressPayloadV2",
      "type": "object"
    },
    "ToolInvocationPayloadV2": {
      "properties": {
        "action": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "input_ref": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Input Ref",
          "type": "string"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "tool": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "action",
        "input_ref",
        "operation_id",
        "lease_epoch"
      ],
      "title": "ToolInvocationPayloadV2",
      "type": "object"
    },
    "ValidationVerdictPayloadV2": {
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit Sha"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "producer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "subject_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Subject Digest",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "test_profile": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Test Profile",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "passed",
            "failed",
            "inconclusive",
            "hold"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "subject_digest",
        "producer_id",
        "test_profile",
        "evidence_refs",
        "summary"
      ],
      "title": "ValidationVerdictPayloadV2",
      "type": "object"
    }
  },
  "$id": "https://schemas.rusa.ai/platform/workflow-event.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.accepted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskAcceptedPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.progress"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskProgressPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "tool.invocation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ToolInvocationPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskCompletedPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskFailedPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "policy.decision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/PolicyDecisionPayloadV2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "policy.violation"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/PolicyViolationPayloadV2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.cancel.requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskCancellationRequestedPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "task.cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/TaskCancelledPayloadV2"
          }
        },
        "required": [
          "task_id",
          "attempt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "approval.requested"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ApprovalRequestPayloadV2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "approval.decided"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ApprovalDecisionPayloadV2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "validation.verdict"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/ValidationVerdictPayloadV2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "audit.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/AuditRecordedPayloadV2"
          }
        }
      }
    }
  ],
  "description": "Versioned workflow event; known event payloads receive strict typed validation.",
  "properties": {
    "attempt": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Event Type",
      "type": "string"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "producer_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Producer Id",
      "type": "string"
    },
    "producer_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sequence"
    },
    "task_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "traceparent": {
      "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$",
      "title": "Traceparent",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "workflow_id",
    "run_id",
    "correlation_id",
    "traceparent",
    "event_type",
    "producer_id",
    "producer_version"
  ],
  "title": "WorkflowEventV2",
  "type": "object"
}
