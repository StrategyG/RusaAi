{
  "$defs": {
    "AICodeQueueStatusV1": {
      "enum": [
        "queued",
        "running",
        "awaiting_approval",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "AICodeQueueStatusV1",
      "type": "string"
    },
    "AICodeTaskStateV1": {
      "enum": [
        "received",
        "observing",
        "planning",
        "executing",
        "verifying",
        "awaiting_approval",
        "succeeded",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "AICodeTaskStateV1",
      "type": "string"
    },
    "AgentDomain": {
      "enum": [
        "shared",
        "software_engineering",
        "intelligence",
        "business",
        "ecosystem"
      ],
      "title": "AgentDomain",
      "type": "string"
    },
    "AgentResultV2": {
      "additionalProperties": false,
      "description": "Typed result. Legacy worker evidence is retained but is not a QA verdict.",
      "properties": {
        "agent_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Agent Version",
          "type": "string"
        },
        "attempt": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Blockers",
          "type": "array"
        },
        "capability": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "legacy_evidence": {
          "additionalProperties": true,
          "title": "Legacy Evidence",
          "type": "object"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "output_refs": {
          "items": {
            "$ref": "#/$defs/ImmutableArtifactReference"
          },
          "maxItems": 256,
          "title": "Output Refs",
          "type": "array"
        },
        "result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskOutcome"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "workflow_id",
        "run_id",
        "task_id",
        "agent_id",
        "agent_version",
        "capability",
        "status",
        "summary"
      ],
      "title": "AgentResultV2",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Immutable evidence reference bound to a content digest.",
      "properties": {
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "producer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "subject_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Digest"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "kind",
        "producer_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "description": "Per-task hard limits; defaults provide a bounded legacy migration envelope.",
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_execution_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Execution Seconds",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_tool_calls": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    },
    "ImmutableArtifactReference": {
      "additionalProperties": false,
      "description": "Tenant-authorized immutable artifact reference bound to a SHA-256 digest.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "ImmutableArtifactReference",
      "type": "object"
    },
    "TaskEnvelopeV2": {
      "additionalProperties": false,
      "description": "Canonical internal task envelope for platform workflow execution.",
      "properties": {
        "agent_id": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Agent Version",
          "type": "string"
        },
        "approval_ref": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Ref"
        },
        "approval_required": {
          "default": false,
          "title": "Approval Required",
          "type": "boolean"
        },
        "attempt": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "budget": {
          "$ref": "#/$defs/ExecutionBudget"
        },
        "capability": {
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
          "title": "Capability",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/AgentDomain"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "input_refs": {
          "items": {
            "$ref": "#/$defs/ImmutableArtifactReference"
          },
          "maxItems": 256,
          "title": "Input Refs",
          "type": "array"
        },
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "policy_context": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Policy Context",
          "type": "object"
        },
        "priority": {
          "default": 5,
          "maximum": 9,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "traceparent": {
          "pattern": "^00-[a-f0-9]{32}-[a-f0-9]{16}-[a-f0-9]{2}$",
          "title": "Traceparent",
          "type": "string"
        },
        "workflow_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Workflow Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "workflow_id",
        "run_id",
        "task_id",
        "traceparent",
        "domain",
        "agent_id",
        "agent_version",
        "capability",
        "deadline_at"
      ],
      "title": "TaskEnvelopeV2",
      "type": "object"
    },
    "TaskOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "awaiting_approval"
      ],
      "title": "TaskOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.rusa.ai/platform/task-record.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compatibility snapshot preserving the existing AICode TaskRecord state and results.",
  "properties": {
    "errors": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "title": "Errors",
      "type": "array"
    },
    "queue_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/AICodeQueueStatusV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "results": {
      "items": {
        "$ref": "#/$defs/AgentResultV2"
      },
      "maxItems": 256,
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AICodeTaskStateV1"
    },
    "task": {
      "$ref": "#/$defs/TaskEnvelopeV2"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "task",
    "state"
  ],
  "title": "TaskRecordSnapshotV2",
  "type": "object"
}
