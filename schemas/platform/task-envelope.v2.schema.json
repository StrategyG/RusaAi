{
  "$defs": {
    "AgentDomain": {
      "enum": [
        "shared",
        "software_engineering",
        "intelligence",
        "business",
        "ecosystem"
      ],
      "title": "AgentDomain",
      "type": "string"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ExecutionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_execution_seconds": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Execution Seconds",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_tool_calls": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        }
      },
      "title": "ExecutionBudget",
      "type": "object"
    }
  },
  "$id": "https://schemas.rusa.ai/platform/task-envelope.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Agent Version",
      "type": "string"
    },
    "approval_ref": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Ref"
    },
    "attempt": {
      "default": 1,
      "maximum": 100,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/ExecutionBudget"
    },
    "capability": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Capability",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline_at": {
      "format": "date-time",
      "title": "Deadline At",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/AgentDomain"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
    },
    "input_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 256,
      "title": "Input Refs",
      "type": "array"
    },
    "message_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "policy_context": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Policy Context",
      "type": "object"
    },
    "priority": {
      "default": 5,
      "maximum": 9,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "traceparent": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    },
    "workflow_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "workflow_id",
    "run_id",
    "task_id",
    "domain",
    "agent_id",
    "agent_version",
    "capability",
    "deadline_at"
  ],
  "title": "TaskEnvelopeV2",
  "type": "object"
}
