{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "Immutable evidence reference bound to a content digest and evaluated subject.",
      "properties": {
        "kind": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "producer_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "subject_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Digest"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "occurred_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred At"
        },
        "producer_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Version"
        },
        "subject_commit": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{40,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Commit"
        },
        "test_profile": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Profile"
        }
      },
      "required": [
        "uri",
        "sha256",
        "kind",
        "producer_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ImmutableArtifactReference": {
      "additionalProperties": false,
      "description": "Tenant-authorized immutable artifact reference bound to a SHA-256 digest.",
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "media_type": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Media Type"
        },
        "sha256": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "ImmutableArtifactReference",
      "type": "object"
    },
    "TaskOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "cancelled",
        "awaiting_approval"
      ],
      "title": "TaskOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.rusa.ai/platform/agent-result.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed result. Legacy worker evidence is retained but is not a QA verdict.",
  "properties": {
    "agent_id": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Agent Id",
      "type": "string"
    },
    "agent_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Agent Version",
      "type": "string"
    },
    "attempt": {
      "default": 1,
      "maximum": 100,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Blockers",
      "type": "array"
    },
    "capability": {
      "pattern": "^[a-z][a-z0-9_.-]{1,127}$",
      "title": "Capability",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "maxItems": 256,
      "title": "Evidence Refs",
      "type": "array"
    },
    "legacy_evidence": {
      "additionalProperties": true,
      "title": "Legacy Evidence",
      "type": "object"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "output_refs": {
      "items": {
        "$ref": "#/$defs/ImmutableArtifactReference"
      },
      "maxItems": 256,
      "title": "Output Refs",
      "type": "array"
    },
    "result_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Result Id",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskOutcome"
    },
    "summary": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "workflow_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Workflow Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "workflow_id",
    "run_id",
    "task_id",
    "agent_id",
    "agent_version",
    "capability",
    "status",
    "summary"
  ],
  "title": "AgentResultV2",
  "type": "object"
}
