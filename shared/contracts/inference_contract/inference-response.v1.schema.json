{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusaai.local/shared/contracts/inference_contract/inference-response.v1.schema.json",
  "title": "RusaAi Inference Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "model_id",
    "status",
    "output",
    "evidence",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "pattern": "^REQ-[A-Za-z0-9._-]{1,124}$" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Za-z0-9._-]{1,124}$" },
    "model_id": { "enum": ["rusaai-edge-1.54b", "rusaai-edge-derived"] },
    "status": { "enum": ["QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED", "TIMED_OUT"] },
    "output": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens"],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttft_ms", "generation_tokens_per_second", "peak_ram_mb"],
      "properties": {
        "ttft_ms": { "type": "number", "minimum": 0 },
        "generation_tokens_per_second": { "type": "number", "minimum": 0 },
        "peak_ram_mb": { "type": "number", "minimum": 0 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "orm_status"],
      "properties": {
        "schema_valid": { "type": "boolean" },
        "orm_status": { "enum": ["PENDING", "PASSED", "FAILED", "NOT_APPLICABLE"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "COMPLETED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["usage", "performance"]
      }
    }
  ]
}
