# rusa-edge-8 (8-GB) device override. Merge after .env.cpu.example.
# Keep the 4K context and one active generation; reduce pending inference work.
RUSA_MODEL_CONTEXT=4096
RUSA_MODEL_PARALLEL=1
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=1
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300
RUSA_MAX_PARALLEL_WORKERS=1
