# rusa-edge-8 (8-GB) device override. Merge after .env.cpu.example and use
# docker-compose.cpu-8gb.yml as the final Compose override.
# Keep the v2.0 4K target only for a compatible audited checkpoint; otherwise
# use the selected checkpoint's supported context (the provisional 556.3M
# training-engine candidate documents 2K, not 4K).
RUSA_MODEL_CONTEXT=4096
RUSA_CPU_THREADS=2
RUSA_MODEL_PARALLEL=1
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=1
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300
RUSA_MAX_PARALLEL_WORKERS=1
RUSA_MODEL_MEMORY_LIMIT=3g
RUSA_MODEL_CPU_LIMIT=2.0
