# rusa-edge-8 (8-GB) Control Plane override.
# Model artifact, llama.cpp, context, threads and Model Plane memory are configured
# in RusaModels separately. Do not copy RusaModels runtime variables into RusaAi.
RUSA_MAX_CONCURRENT_INFERENCES=1
RUSA_MAX_WAITING_INFERENCES=1
RUSA_INFERENCE_QUEUE_TIMEOUT_SECONDS=60
RUSA_GENERATION_TIMEOUT_SECONDS=300
RUSA_MAX_PARALLEL_WORKERS=1
