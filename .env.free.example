# Copy to .env.free locally; never commit .env.free.
# Development-only password. Set a unique value before starting PostgreSQL.
RUSA_DEV_DB_PASSWORD=replace-with-a-long-random-development-password

# After applying migrations 001-010 and creating the restricted login described
# in docs/RUSA_AI_FREE_TIER_EXECUTION_RUNBOOK.md:
RUSA_KNOWLEDGE_DATABASE_URL=postgresql://rusa_knowledge_login:REPLACE_ME@127.0.0.1:54329/rusa
RUSA_KNOWLEDGE_DB_ROLE=rusa_knowledge_worker

# RUSA currently requires 1536-dimensional embeddings.
# This provider must be OpenAI-compatible and return exactly 1536 dimensions.
# No provider/API key is supplied by this template; free quotas are not guaranteed.
RUSA_EMBEDDING_BASE_URL=https://api.openai.com/v1
RUSA_EMBEDDING_API_KEY=
RUSA_EMBEDDING_MODEL=text-embedding-3-small

# Do not set production credentials in Codespaces public ports or notebooks.
