FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY requirements-agent.txt .
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir -r requirements-agent.txt \
    && /venv/bin/pip check \
    && /venv/bin/pip uninstall -y pip setuptools wheel jaraco.context \
    && rm -f /venv/bin/pip /venv/bin/pip3 /venv/bin/pip3.13

FROM python:3.13-slim-trixie@sha256:09a17cad02668ae61ece136b4fd36ac3849e14f670ebedb637ea3e15580525bc AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    PATH="/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && for package in python3-msgpack python3-urllib3 python3-setuptools; do \
         if dpkg-query -s "$package" >/dev/null 2>&1; then \
           apt-get purge -y "$package"; \
         fi; \
       done \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip setuptools wheel jaraco.context \
    && groupadd --system --gid 10001 rusa \
    && useradd --system --uid 10001 --gid rusa --home-dir /nonexistent --shell /usr/sbin/nologin rusa \
    && mkdir -p /var/lib/rusa-agent \
    && chown -R 10001:10001 /var/lib/rusa-agent

COPY --from=builder --chown=10001:10001 /venv /venv
COPY --chown=10001:10001 rusa_agents /app/rusa_agents

USER 10001:10001

ENTRYPOINT ["python"]
CMD ["-m", "rusa_agents.worker"]
