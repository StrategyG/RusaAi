FROM cgr.dev/chainguard/python:3.11-dev AS builder

USER root
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY requirements-agent.txt .
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir -r requirements-agent.txt \
    && /venv/bin/pip uninstall -y pip setuptools wheel jaraco.context \
    && rm -f /venv/bin/pip /venv/bin/pip3 /venv/bin/pip3.11 \
    && mkdir -p /var/lib/rusa-agent \
    && chown -R 65532:65532 /var/lib/rusa-agent

FROM cgr.dev/chainguard/python:3.11 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /venv /venv
COPY --from=builder --chown=65532:65532 /var/lib/rusa-agent /var/lib/rusa-agent
COPY --chown=65532:65532 rusa_agents /app/rusa_agents

USER 65532:65532

ENTRYPOINT ["/venv/bin/python"]
CMD ["-m", "rusa_agents.worker"]
