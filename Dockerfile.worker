FROM python:3.13-slim-trixie AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY requirements-agent.txt .
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir -r requirements-agent.txt \
    && /venv/bin/pip install --no-cache-dir --upgrade "msgpack>=1.2.3,<2" "urllib3>=2.8.0,<3" \
    && /venv/bin/pip uninstall -y pip setuptools wheel jaraco.context \
    && rm -f /venv/bin/pip /venv/bin/pip3 /venv/bin/pip3.13

FROM python:3.13-slim-trixie AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    PATH="/venv/bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y setuptools wheel jaraco.context \
    && groupadd --system --gid 10001 rusa \
    && useradd --system --uid 10001 --gid rusa --home-dir /nonexistent --shell /usr/sbin/nologin rusa \
    && mkdir -p /var/lib/rusa-agent \
    && chown -R 10001:10001 /var/lib/rusa-agent

COPY --from=builder --chown=10001:10001 /venv /venv
COPY --chown=10001:10001 rusa_agents /app/rusa_agents

USER 10001:10001

ENTRYPOINT ["python"]
CMD ["-m", "rusa_agents.worker"]
