FROM python:3.12.16-slim-trixie AS builder

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY rusa_agents ./rusa_agents
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir . \
    && python -m pip install --no-cache-dir --upgrade \
         "setuptools>=84.1.0" "wheel>=0.46.2" "jaraco.context>=6.1.0" \
    && python -m pip check \
    && python -m pip uninstall -y setuptools wheel jaraco.context \
    && python -m pip uninstall -y pip \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12

# Clean runtime base: no inherited Python base layers or stale setuptools SBOM.
FROM debian:trixie-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    LD_LIBRARY_PATH=/usr/local/lib
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io git ca-certificates libexpat1 libffi8 libssl3t64 libbz2-1.0 liblzma5 libsqlite3-0 libreadline8t64 libncursesw6 libgdbm6t64 libgdbm-compat4t64 zlib1g libuuid1 libcrypt1 libnsl2 libtirpc3t64 libatomic1 \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && echo /usr/local/lib > /etc/ld.so.conf.d/usr-local.conf \
    && ldconfig \
    && useradd --create-home --uid 10001 appuser

COPY --from=builder /usr/local /usr/local
COPY --chown=appuser:appuser . /app

RUN ldd /usr/local/bin/python3.12 | tee /tmp/python-ldd \
    && ! grep -q "not found" /tmp/python-ldd \
    && python - <<'PY'
from importlib import import_module, metadata

for package in ("pip", "setuptools", "wheel", "jaraco.context"):
    try:
        metadata.version(package)
    except metadata.PackageNotFoundError:
        continue
    raise SystemExit(f"Build-only package {package} remains in the worker runtime")

for module in ("rusa_agents", "psycopg", "prometheus_client", "httpx"):
    import_module(module)
print("Worker runtime imports verified; build tooling is absent.")
PY

USER appuser
EXPOSE 9100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/metrics', timeout=3)" || exit 1

CMD ["python", "-m", "rusa_agents.worker_main"]
