FROM python:3.12.16-slim-trixie AS builder

WORKDIR /build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY docker/build-patched-native-libs.sh /tmp/build-patched-native-libs.sh
RUN sh /tmp/build-patched-native-libs.sh
COPY pyproject.toml README.md requirements-rag-worker.txt ./
COPY rusa_agents ./rusa_agents
COPY rusa_knowledge ./rusa_knowledge
ARG RUSA_INSTALL_RAG=0
RUN python -m pip install --upgrade pip "setuptools>=84.1.0" "wheel>=0.46.2" \
    && python -m pip install . \
    && if [ "$RUSA_INSTALL_RAG" = "1" ]; then \
         python -m pip install -r requirements-rag-worker.txt; \
       fi

# Runtime image contains only the Python runtime and application dependencies.
# Build tools are removed before copying, so no package manager or build backend
# is shipped in the worker container.
RUN python -m pip uninstall -y setuptools wheel jaraco.context \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && find /usr/local/lib/python3.12 -type d \( -name 'setuptools-*.dist-info' -o -name 'wheel-*.dist-info' -o -name 'pip-*.dist-info' \) -prune -exec rm -rf '{}' + \
    && python - <<'PY'
from importlib.metadata import PackageNotFoundError, version

for package in ("pip", "setuptools", "wheel", "jaraco.context"):
    try:
        installed = version(package)
    except PackageNotFoundError:
        continue
    raise SystemExit(f"build-only package {package}=={installed} remains in worker runtime")
PY

FROM debian:trixie-slim AS runner
ARG RUSA_INSTALL_RAG=0

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 LD_LIBRARY_PATH=/usr/local/lib RUSA_INSTALL_RAG=${RUSA_INSTALL_RAG}
ARG DOCKER_CE_CLI_VERSION=5:29.9.3-1~debian.13~trixie

# Install only Docker CLI (not dockerd, containerd, or runc). The worker talks
# to the separately managed rootless daemon through the mounted Unix socket.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git \
    && apt-get upgrade -y --no-install-recommends \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "docker-ce-cli=${DOCKER_CE_CLI_VERSION}" \
    && apt-get purge -y --auto-remove curl \
    && apt-get purge -y libexpat1 libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 appuser

COPY --from=builder /usr/local /usr/local
COPY --chown=appuser:appuser . /app

RUN ldd /usr/local/bin/python3.12 | tee /tmp/python-ldd \
    && ! grep -q "not found" /tmp/python-ldd \
    && docker --version \
    && if dpkg-query -W -f='${binary:Package}\n' | grep -Eq '^(docker.io|docker-ce|containerd|containerd.io|runc)$'; then \
         echo "Worker image must ship Docker CLI only, not a Docker daemon/runtime"; exit 1; \
       fi \
    && python - <<'PY'
import importlib

import pyexpat, sqlite3
if pyexpat.EXPAT_VERSION != "expat_2.10.0":
    raise SystemExit(f"Unpatched Expat runtime: {pyexpat.EXPAT_VERSION}")
if sqlite3.sqlite_version_info < (3, 54, 1):
    raise SystemExit(f"Unpatched SQLite runtime: {sqlite3.sqlite_version}")
print(f"Patched native libraries active: {pyexpat.EXPAT_VERSION}; SQLite {sqlite3.sqlite_version}")

for module in ("rusa_agents.worker_main", "psycopg", "prometheus_client", "httpx"):
    importlib.import_module(module)
if __import__("os").getenv("RUSA_INSTALL_RAG") == "1":
    importlib.import_module("rusa_knowledge.service")
print("worker runtime imports passed")
PY

USER appuser
EXPOSE 9100

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/metrics', timeout=3)" || exit 1

CMD ["python", "-m", "rusa_agents.worker_main"]
