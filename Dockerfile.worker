FROM python:3.13-slim-trixie AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build
COPY requirements-agent.txt .
RUN python -m pip install --no-cache-dir --prefix=/install -r requirements-agent.txt \
    && mkdir -p /var/lib/rusa-agent \
    && chown -R 65532:65532 /var/lib/rusa-agent

FROM gcr.io/distroless/python3-debian13:nonroot AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONPATH=/usr/local/lib/python3.13/site-packages

WORKDIR /app

COPY --from=builder /install /usr/local
COPY --from=builder --chown=65532:65532 /var/lib/rusa-agent /var/lib/rusa-agent
COPY --chown=65532:65532 rusa_agents /app/rusa_agents

USER 65532:65532

ENTRYPOINT ["python"]
CMD ["-m", "rusa_agents.worker"]
