{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rusaai:local-bundle-manifest:1.0",
  "title": "RUSA AI Local Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "release_version",
    "release_channel",
    "platform",
    "architecture",
    "release_status",
    "images",
    "model",
    "embedding",
    "files",
    "required_memory_bytes",
    "required_disk_bytes",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "product": { "const": "RUSA AI Local" },
    "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$" },
    "release_channel": { "enum": ["stable", "preview"] },
    "platform": { "const": "windows" },
    "architecture": { "const": "x86_64" },
    "release_status": { "enum": ["READY", "NOT_READY"] },
    "minimum_os_build": { "type": "integer", "minimum": 22000 },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "web", "model_server", "model_runtime"],
      "properties": {
        "api": { "$ref": "#/$defs/image" },
        "web": { "$ref": "#/$defs/image" },
        "model_server": { "$ref": "#/$defs/image" },
        "model_runtime": { "$ref": "#/$defs/image" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "status", "source_revision", "license", "tokenizer_revision", "context_tokens", "artifact_file", "artifact_sha256"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["APPROVED", "NOT_APPROVED"] },
        "source_revision": { "type": "string", "minLength": 40, "maxLength": 64 },
        "license": { "type": "string", "minLength": 1 },
        "tokenizer_revision": { "type": "string", "minLength": 40, "maxLength": 64 },
        "context_tokens": { "type": "integer", "minimum": 512 },
        "artifact_file": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "status", "revision", "license", "dimensions", "artifact_sha256"],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["APPROVED", "NOT_APPROVED"] },
        "revision": { "type": "string", "minLength": 40, "maxLength": 64 },
        "license": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "required_memory_bytes": { "type": "integer", "minimum": 1 },
    "required_disk_bytes": { "type": "integer", "minimum": 1 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "signature_file"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "signature_file": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release_status": { "const": "READY" } }, "required": ["release_status"] },
      "then": {
        "properties": {
          "model": { "properties": { "status": { "const": "APPROVED" } } },
          "embedding": { "properties": { "status": { "const": "APPROVED" } } }
        }
      }
    }
  ],
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
